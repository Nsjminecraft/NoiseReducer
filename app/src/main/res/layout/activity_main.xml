<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start"
        android:textSize="20sp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtInputDevice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Input: Phone mic"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <Switch
        android:id="@+id/switchAdaptive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto-Adjust (Adaptive)"
        android:checked="true"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtNoiseLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Noise Level: 0.000"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/txtCurrentGain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Gain: 0.20"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtGain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gain: 0.20"
        android:layout_marginBottom="4dp" />
    <SeekBar
        android:id="@+id/seekGain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtGate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gate: 0.010"
        android:layout_marginBottom="4dp" />
    <SeekBar
        android:id="@+id/seekGate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtHPF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HPF: 200 Hz"
        android:layout_marginBottom="4dp" />
    <SeekBar
        android:id="@+id/seekHPF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtLPF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LPF: 2000 Hz"
        android:layout_marginBottom="4dp" />
    <SeekBar
        android:id="@+id/seekLPF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

</LinearLayout>
